{
  // Phase 10A -- DRAFT (illustrative, not a live capture).
  //
  // Illustrative shape of the conversation-states surface: one project,
  // several conversations, each reduced to its last committed turn via
  // ConversationStore.project_states (key-scoped, bounded, no event
  // replay). The optional "live" block is the per-turn view attached by
  // HandoffCoordinator.build_conversation_snapshot when a turn is active.
  //
  // All conversation/project ids here are opaque hashes, never raw
  // user data (architecture S7). The model / provider strings are the
  // same identifiers used in the continuity "models:" envelope.

  "project_key": "proj_1f8e2a9c0d1b",
  "key_id": "key_9a31f04e",
  "conversation_count": 3,
  "states": [
    {
      "project_key": "proj_1f8e2a9c0d1b",
      "client_bucket": "opencode",
      "conversation_id": "c1d0a3f2e9b84a61",
      "key_id": "key_9a31f04e",
      // Last committed turn (highest seq). seq always advances even when
      // the turn committed without a model (Phase 10A empty-model
      // contract); a fresh state seeds next_seq from last_seq + 1.
      "last_seq": 14,
      "last_model": "anthropic/claude-opus-4-2026",
      "last_provider": "anthropic",
      "last_outcome": "ok",
      // Live view attached by build_conversation_snapshot while the next
      // turn (seq 15) is in flight. anchor_* is the continuation anchor
      // at turn start (P9B), refreshed by durable resumes.
      "live": {
        "turn_id": "c1d0a3f2e9b84a61:15",
        "seq": 15,
        "last_seq": 14,
        "anchor_provider": "anthropic",
        "anchor_model": "anthropic/claude-opus-4-2026",
        "model_chain": [
          "anthropic/claude-sonnet-4-2026",
          "anthropic/claude-opus-4-2026"
        ]
      }
    },
    {
      // Empty-model contract (Phase 10A): this conversation's last turn
      // committed without a model (e.g. a denied/aborted turn after the
      // model decision was not recorded). last_seq still advances --
      // last_model stays null and the durable anchor falls back to the
      // previous turn until a real model turn commits. Nothing here
      // restarts the conversation at seq 1 (no UNIQUE
      // (conversation_id, seq) collision on the next commit).
      "project_key": "proj_1f8e2a9c0d1b",
      "client_bucket": "continue",
      "conversation_id": "b93c7e01d2f4a855",
      "key_id": "key_9a31f04e",
      "last_seq": 8,
      "last_model": null,
      "last_provider": "opencode",
      "last_outcome": "ok",
      "live": {
        "turn_id": "b93c7e01d2f4a855:9",
        "seq": 9,
        "last_seq": 8,
        "anchor_provider": null,
        "anchor_model": null,
        "model_chain": []
      }
    },
    {
      "project_key": "proj_1f8e2a9c0d1b",
      "client_bucket": "cline",
      "conversation_id": "e71c9b3d8a05f2c4",
      "key_id": "key_9a31f04e",
      "last_seq": 3,
      "last_model": "openrouter/deepseek-r1",
      "last_provider": "openrouter",
      "last_outcome": "failed",
      // A conversation with no in-flight turn has no "live" block; the
      // durable projection alone describes it.
      "live": null
    }
  ]
}
