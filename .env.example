# =========================
# Relay Configuration
# =========================

# Provider toggles
NVIDIA_ENABLED=true
OPENAI_ENABLED=false
LMSTUDIO_ENABLED=false

# NVIDIA
NVIDIA_API_KEY=
NVIDIA_MODEL_PRIORITY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_PRIORITY=

# LM Studio (local OpenAI-compatible endpoint; API key optional)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_PRIORITY=1
LMSTUDIO_MODEL_PRIORITY=

# Failover
MAX_RETRIES=1

# Task routing (optional; skipped categories use normal ordering)
TASK_ROUTING_ENABLED=false
TASK_CODING=
TASK_VISION=
TASK_REASONING=
TASK_GENERAL=
TASK_CREATIVE=
TASK_TRANSLATION=

# Logging (LOG_FILE empty = stdout only)
LOG_LEVEL=INFO
LOG_FILE=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Groq
GROQ_API_KEY=

# Local Providers
OLLAMA_BASE_URL=http://localhost:11434

# Relay
DEFAULT_PROVIDER=NVIDIA

# Server bind (used when `relay` launches the application)
RELAY_HOST=127.0.0.1
RELAY_PORT=8000

# Configuration file and setup-state locations (optional overrides)
# RELAY_ENV_FILE=
# RELAY_STATE_DIR=

# API authentication (empty = disabled; all endpoints accessible)
# When set, every endpoint except "/" and "/health" requires one of:
#   Authorization: Bearer <RELAY_API_KEY>
#   X-Relay-API-Key: <RELAY_API_KEY>
RELAY_API_KEY=

# =========================
# Intelligence & learning
# =========================
# All flags below default to false, which keeps routing byte-identical
# to the original priority/failover behavior. Enable them in this order
# to activate the full production intelligence profile:

# 1) Operational telemetry: records success/latency/failure per attempt.
#    Feeds adaptive learning and health feedback. Without it the other
#    learning systems have no signal to learn from.
TELEMETRY_ENABLED=false

# 2) Health learning: turns real chat failures into provider/model health
#    state. Degraded/unavailable models are then excluded from routing.
HEALTH_FEEDBACK_ENABLED=false
HEALTH_AWARE_ROUTING=false

# 3) Adaptive EWMA routing: reorders candidates within a health band by
#    recent (exponentially weighted) reliability/latency once a provider
#    model has enough observations. Requires TELEMETRY_ENABLED.
ADAPTIVE_ROUTING_ENABLED=false
ADAPTIVE_MIN_SAMPLES=10
ADAPTIVE_LEARNING_RATE=0.1
ADAPTIVE_LATENCY_WEIGHT=1.0
ADAPTIVE_RELIABILITY_WEIGHT=1.0

# 4) Quality feedback: blends end-user quality ratings (/feedback) into
#    scoring once a model has enough samples.
QUALITY_FEEDBACK_ENABLED=false
QUALITY_FEEDBACK_MIN_SAMPLES=10
QUALITY_FEEDBACK_LEARNING_RATE=0.1
QUALITY_FEEDBACK_WEIGHT=1.0

# 5) Decision engine: additive per-request selection audit exposed via
#    /decision/explain. It never changes the routed result; enable it
#    when you want to observe why candidates were ranked the way they
#    were.
DECISION_ENGINE_ENABLED=false
DECISION_EXPLANATIONS_ENABLED=false

# 6) Persistence: keep learned state across restarts. Recommended in
#    production once the profile above is enabled, otherwise all learned
#    state is lost on process exit.
PERSISTENCE_ENABLED=false
PERSISTENCE_PATH=
PERSISTENCE_FLUSH_INTERVAL_SECONDS=60
PERSISTENCE_RETENTION_DAYS=0

# Recommended production profile: enable 1-6 above (all = true) with
# default thresholds. Leave HEALTH_REFRESH_ENABLED=false unless a live
# background prober can reach every provider endpoint.
HEALTH_REFRESH_ENABLED=false
HEALTH_REFRESH_INTERVAL_SECONDS=300
HEALTH_DEEP_REFRESH_ENABLED=false