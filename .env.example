# =========================
# Relay Configuration
# =========================
# Every environment variable parsed by Relay is listed below, grouped by
# subsystem, with the default that applies when the variable is absent or
# empty. Copy this file to `.env` (or use `relay setup`) and edit.

# =========================
# Server bind
# =========================

# Host/port used when `relay` / `relay serve` launches the application.
RELAY_HOST=127.0.0.1
RELAY_PORT=8000

# =========================
# Configuration and state locations
# =========================

# Override the `.env` file location (default: `.env` in the working
# directory, else next to the app package; installed packages use the
# per-user data directory).
# RELAY_ENV_FILE=

# Override the setup/state directory (default: `.relay` next to the env
# file for source checkouts; the user data directory for installed
# packages). Holds platform.db, availability.json, state.json.
# RELAY_STATE_DIR=

# Override the per-user data directory used by installed packages.
# Defaults to the platform user data dir (~/.local/share/relay on Linux,
# %LOCALAPPDATA%\relay on Windows). Tests and headless installs set this
# to redirect every write away from the user profile.
# RELAY_DATA_DIR=

# =========================
# Logging (LOG_FILE empty = stdout only)
# =========================
LOG_LEVEL=INFO
LOG_FILE=

# =========================
# Request behavior and failover
# =========================

# Total retries per request (0 = no retry). Applies on 5xx, timeouts,
# malformed bodies, and (subject to the retry policy below) 429s.
MAX_RETRIES=1

# Per-attempt timeout for a provider request, in seconds.
REQUEST_TIMEOUT=120

# Honor the provider's Retry-After header on 429 (and other) responses.
# Off by default, preserving immediate-retry behavior.
RETRY_HONOR_RETRY_AFTER=false

# Cap on the Retry-After delay, in seconds, when honored.
RETRY_AFTER_MAX_SECONDS=60

# Exponential backoff base between retries, in seconds. 0 disables
# backoff (immediate retry).
RETRY_BACKOFF_BASE_SECONDS=0

# Cap on the backoff delay, in seconds.
RETRY_BACKOFF_MAX_SECONDS=60

# Overall wall-clock budget for a chat request, in seconds. 0 disables
# the budget.
REQUEST_TIMEOUT_BUDGET_SECONDS=0

# =========================
# Outbound proxy
# =========================

# Outbound provider requests honor the standard proxy variables. Set
# PROXY_ENABLED=false to disable proxy support entirely.
PROXY_ENABLED=true
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# =========================
# Provider toggles
# =========================
NVIDIA_ENABLED=true
OPENAI_ENABLED=false
LMSTUDIO_ENABLED=false
ANTHROPIC_ENABLED=false
GEMINI_ENABLED=false
OLLAMA_ENABLED=false

# =========================
# Model priority
# =========================
# Comma-separated ordered model list per provider. When set, matching
# models are preferred in the listed order before the remaining catalog.

NVIDIA_MODEL_PRIORITY=
OPENAI_MODEL_PRIORITY=
ANTHROPIC_MODEL_PRIORITY=
GEMINI_MODEL_PRIORITY=
OLLAMA_MODEL_PRIORITY=
LMSTUDIO_MODEL_PRIORITY=

# =========================
# NVIDIA
# =========================
# (deprecated in P5: provider keys now belong in the OS keyring via
#  RELAY_KEYRING; these env vars are still honored as the runtime
#  fallback and are removed by `relay provider keys migrate`)
NVIDIA_API_KEY=

# =========================
# OpenAI
# =========================
OPENAI_API_KEY=

# =========================
# Anthropic
# =========================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# =========================
# Google Gemini
# =========================
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =========================
# LM Studio (local OpenAI-compatible endpoint; API key optional)
# =========================
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_PRIORITY=1

# =========================
# Ollama (local endpoint; no API key)
# =========================
OLLAMA_BASE_URL=http://localhost:11434

# =========================
# API authentication (empty = disabled; all endpoints accessible)
# =========================
# When set, every endpoint except "/" and "/health" requires one of:
#   Authorization: Bearer <RELAY_API_KEY>
#   X-Relay-API-Key: <RELAY_API_KEY>
RELAY_API_KEY=

# Store-backed API keys: when true, the auth dependency also accepts keys
# from platform.db (scrypt-hashed; create with `relay keys add`).
# RELAY_AUTH_STORE=false

# =========================
# Provider-key storage
# =========================
# When true, provider keys resolve keyring-first and
# `relay provider keys set` writes to the OS keyring instead of .env. Use
# `relay provider keys migrate` to move existing .env keys into the keyring.
# RELAY_KEYRING=false

# Dotted module.Class path naming a keyring backend for headless servers
# (the keyring package otherwise picks a desktop backend, and there may be
# none on a headless box). See docs/security.md.
# RELAY_KEYRING_BACKEND=

# =========================
# Terminal UI
# =========================
# When true, `relay` runs the TUI without the embedded API server (pair it
# with a separately managed `relay serve`). The TUI needs an interactive
# terminal; when launched without one Relay prints guidance and exits
# cleanly instead of crashing. Use `relay serve` for headless operation.
RELAY_TUI_NO_EMBED=false

# =========================
# Task routing (optional; skipped categories use normal ordering)
# =========================
TASK_ROUTING_ENABLED=false

# When true, a bare model reference may match models across providers
# (not just within the requesting provider).
CROSS_PROVIDER_MODEL_SELECTION=false

# Ordered model lists per task category.
TASK_CODING=
TASK_VISION=
TASK_REASONING=
TASK_GENERAL=
TASK_CREATIVE=
TASK_TRANSLATION=

# =========================
# Free-text task classification
# =========================
# Classifies free-text /chat requests when no explicit task is given.
# Off by default: the endpoint keeps validating the explicit task field.
TASK_CLASSIFICATION_ENABLED=false
TASK_CLASSIFICATION_THRESHOLD=0.6

# =========================
# Task capability catalog
# =========================
# Adds a task-compatibility signal to within-band scoring. Off by default
# so candidate ordering stays byte-identical to the legacy formula.
TASK_CATALOG_ENABLED=false

# Weight of the task-compatibility signal within the band (used when the
# catalog is enabled).
SCORING_TASK_COMPATIBILITY_WEIGHT=1.0

# =========================
# Scoring tuning
# =========================
# Relative signal weights and reference values for the within-band score.
# With the default profile all weights are equal (1.0) and ordering stays
# byte-identical to the priority/failover baseline.
SCORING_PRIORITY_WEIGHT=1.0
SCORING_SUCCESS_WEIGHT=1.0
SCORING_LATENCY_WEIGHT=1.0
SCORING_FAILURE_WEIGHT=1.0
SCORING_PREFERENCE_WEIGHT=1.0
SCORING_PRIORITY_DENOM=10
SCORING_LATENCY_REF_MS=250
SCORING_FAILURE_REF_COUNT=5
# Future cost placeholder weight. Defaults to 0.0 so ordering stays
# byte-identical; only meaningful once cost data is wired in.
SCORING_COST_WEIGHT=0.0

# =========================
# Intelligence & learning
# =========================
# All flags below default to false, which keeps routing byte-identical
# to the original priority/failover behavior. Enable them in this order
# to activate the full production intelligence profile:

# 1) Operational telemetry: records success/latency/failure per attempt.
#    Feeds adaptive learning and health feedback. Without it the other
#    learning systems have no signal to learn from.
TELEMETRY_ENABLED=false

# Cap on distinct (provider, model) failure records kept for telemetry.
TELEMETRY_MAX_FAILURE_HISTORY=50

# 2) Health learning: turns real chat failures into provider/model health
#    state. Degraded/unavailable models are then excluded from routing.
HEALTH_FEEDBACK_ENABLED=false
HEALTH_AWARE_ROUTING=false

# Health-state timestamps, in seconds. HEALTH_TTL_SECONDS is the general
# freshness window; DEGRADED/UNAVAILABLE override it per state.
HEALTH_TTL_SECONDS=300
HEALTH_DEGRADED_TTL_SECONDS=60
HEALTH_UNAVAILABLE_TTL_SECONDS=900

# Background prober: leave disabled unless a live prober can reach every
# provider endpoint.
HEALTH_REFRESH_ENABLED=false
HEALTH_REFRESH_INTERVAL_SECONDS=300
HEALTH_DEEP_REFRESH_ENABLED=false

# Health feedback tuning thresholds (counts of recent outcomes).
HEALTH_FEEDBACK_MODEL_SERVER_ERROR_THRESHOLD=1
HEALTH_FEEDBACK_PROVIDER_SERVER_ERROR_THRESHOLD=3
HEALTH_FEEDBACK_MODEL_TIMEOUT_DEGRADED_THRESHOLD=2
HEALTH_FEEDBACK_MODEL_TIMEOUT_UNAVAILABLE_THRESHOLD=5
HEALTH_FEEDBACK_MODEL_INVALID_REQUEST_UNAVAILABLE_THRESHOLD=3
HEALTH_FEEDBACK_MODEL_UNKNOWN_DEGRADED_THRESHOLD=3

# Exponent on the health-signal freshness weight.
HEALTH_FRESHNESS_EXPONENT=1.0

# 3) Adaptive EWMA routing: reorders candidates within a health band by
#    recent (exponentially weighted) reliability/latency once a provider
#    model has enough observations. Requires TELEMETRY_ENABLED.
ADAPTIVE_ROUTING_ENABLED=false
ADAPTIVE_MIN_SAMPLES=10
ADAPTIVE_LEARNING_RATE=0.1
ADAPTIVE_LATENCY_WEIGHT=1.0
ADAPTIVE_RELIABILITY_WEIGHT=1.0

# 4) Quality feedback: blends end-user quality ratings (/feedback) into
#    scoring once a model has enough samples.
QUALITY_FEEDBACK_ENABLED=false
QUALITY_FEEDBACK_MIN_SAMPLES=10
QUALITY_FEEDBACK_LEARNING_RATE=0.1
QUALITY_FEEDBACK_RETENTION_LIMIT=10000
QUALITY_FEEDBACK_WEIGHT=1.0

# 5) Decision engine: additive per-request selection audit exposed via
#    /decision/explain. It never changes the routed result; enable it
#    when you want to observe why candidates were ranked the way they
#    were.
DECISION_ENGINE_ENABLED=false
DECISION_EXPLANATIONS_ENABLED=false

# =========================
# Observability / operations
# =========================
# Rolling in-memory operations window for diagnostics (0 disables
# time-based pruning). Never persisted to SQLite.
OPS_WINDOW_SECONDS=300
OPS_MAX_EVENTS=10000

# =========================
# Persistence
# =========================
# Keep learned state across restarts. Recommended in production once the
# profile above is enabled, otherwise all learned state is lost on
# process exit.
PERSISTENCE_ENABLED=false
# Default: <state_dir>/platform.db. Set to relocate the database.
PERSISTENCE_PATH=
PERSISTENCE_FLUSH_INTERVAL_SECONDS=60
# Retention (days) for learned failure history AND the security event log
# (the `events` table in state_dir/platform.db). 0 disables pruning.
PERSISTENCE_RETENTION_DAYS=0
# Durable request log (the `request_log` table in state_dir/platform.db).
# Metadata only: ts, route, method, status, latency, opaque key id, client
# bucket, trimmed User-Agent, and auth-scheme label. Never prompts,
# bodies, responses, or raw keys.
REQUEST_LOG_FLUSH_INTERVAL_SECONDS=5
# Retention (days) for request-log rows; 0 disables pruning.
REQUEST_LOG_RETENTION_DAYS=30

# =========================
# Project continuity (P9, phase a)
# =========================
# Metadata-only project continuity on platform.db (schema v7): opaque
# conversation/project identities, turn metadata, redacted bounded
# summaries, compaction records, and per-project derived state. Raw
# prompts/responses are never captured. Off by default; when off, the
# continuity stores stay inert and `relay conversations` reports
# "continuity disabled". The full handoff stack (headers, buffers,
# summarization) is a later phase and is not active yet.
CONTINUITY_ENABLED=false

# Retention (days) for archived-or-idle conversations; 0 disables pruning.
CONTINUITY_RETENTION_DAYS=30

# Write-behind flush interval for the continuity buffer, in seconds.
CONTINUITY_FLUSH_INTERVAL_SECONDS=5

# Token budget reserved for the continuity context window.
CONTINUITY_CONTEXT_TOKEN_BUDGET=32768

# Tokens reserved from the context budget for the response.
CONTINUITY_OUTPUT_RESERVE_TOKENS=2048

# Fraction (0..1) of the context budget reserved for summaries.
CONTINUITY_SUMMARY_SHARE=0.4

# Max characters of a stored summary body.
CONTINUITY_SUMMARY_MAX_CHARS=4096

# Max trailing turns kept after a compaction.
CONTINUITY_TAIL_MAX_ITEMS=20

# Estimated characters per token used for budget math.
CONTINUITY_CHARS_PER_TOKEN=4

# Empty = extractive-only summaries (no LLM summarizer). Set to a model
# id to enable LLM-based summaries in a later phase.
CONTINUITY_SUMMARIZER_MODEL=

# =========================
# Continuity switch/state guardrails (P9b+)
# =========================
# Bounds enforced by the handoff coordinator in later phases; reserved
# now so their defaults are documented and restart-validated.
MAX_SWITCHES_PER_TURN=3
MAX_SWITCHES_PER_WINDOW=5
MAX_RESUME_REPLAYS=3
