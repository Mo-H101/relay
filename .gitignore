# Secrets and local configuration — never commit.
.env

# Stale operational artifacts.
health.json

# Persistence database (contains learned state; do not commit).
relay_state.db
*.db

# Python.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Packaging/build artifacts.
dist/
build/
*.egg-info/

# Setup/state marker directory.
.relay/

# Agent/tooling config.
.agents/
skills-lock.json

# Logs.
*.log

# NVIDIA model benchmark runtime output (docs/nvidia-model-benchmark-plan.md §6).
# bench/prompts.json stays tracked; everything else under bench/ is generated.
bench/raw/
bench/probe.json
bench/results.json
bench/report.md

# Release Candidate validation bundle (generated; not part of the source tree).
release-candidate/
